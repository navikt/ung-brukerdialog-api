<style>

    @page {
        size: A4 portrait;
        margin: 1cm 0.3cm 0.5cm;
        padding-bottom: 1cm;

        @bottom-left {
            content: element(footer);
        }
    }

    @page:first {
        margin-top: 0;
        @top-left {
            content: element(header);
        }
    }

    * {
        font-family: "Source Sans Pro";
    }

    h1 {
        font-weight: 700;
        font-style: normal;
        font-size: 24px;
    }

    h2 {
        width: 100%;
        text-align: center;
        border-bottom: 1px solid #000;
        line-height: 0.1em;
        margin: 30px 0;
    }

    h2 span {
        font-size: 20px;
        background: #fff;
        padding: 0 10px;
    }

    h3 {
        font-weight: 700;
        font-style: normal;
        font-size: 14px;
        margin-top: 5px;
        margin-bottom: 5px;
    }

    p {
        margin: 0 0 16px 0;
        font-size: 16px;
        line-height: 1.5;
    }

    li {
        margin: 0 0 8px 0;
        font-size: 16px;
        line-height: 1.5;
    }

    /* Fet skrift for hele blokken - satt av OppgaveTekst#fet() (f.eks. den innledende
       svarfrist-setningen). Gjelder hele blokken, ikke enkeltord/delsetninger - se Fase 1-
       beslutning i plansporet for denne modellen. Bevisst tap: den forrige seksjonsbrudd-
       marginen før svarfrist-avsnittet (.frist { margin-top: 24px }) er ikke gjenskapt, siden
       den flate blokklisten ikke har noe strukturelt signal for et slikt skille. */
    .fet, .fet li, .fet th, .fet td {
        font-weight: 700;
    }

    hr {
        display: block;
        height: 1px;
        border: 0;
        border-top: 1px solid #ccc;
        margin: 1em 0;
        padding: 0;
    }

    /* Lenke inn i flytende brødtekst (se lenkify-Handlebars-helperen i PdfGenerator). */
    a {
        color: #0067c5;
        text-decoration: underline;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        text-align: left;
        padding: 12px 16px;
        font-size: 16px;
    }

    th:last-child, td:last-child {
        text-align: right;
    }

    thead tr, tbody tr {
        border-bottom: 1px solid #cfd3d8;
    }

    /* To-kolonne header: navn/fødselsnummer venstre, Nav-logo + opprettet dato høyre.
       Float (ikke flex - openhtmltopdf 1.1.66 støtter ikke CSS flexbox), samme teknikk
       som .sidetall lenger ned i denne filen. Tittelen (#header) er en tredje,
       ikke-floatet rad inni denne containeren (clear: both under). Klassen heter
       «header» fordi hele partial-en (navn/fnr, logo/dato og tittel) er samlet i
       partial/header.hbs - selve tittelraden har fortsatt id="header" (se under), uten
       navnekollisjon siden class og id er egne navnerom. */
    .header {
        padding: 0.5cm 0.7cm 0.4cm;
        overflow: hidden;
    }

    .dokumentinfo {
        float: right;
        text-align: right;
    }

    .dokumentinfo img {
        width: 3cm;
        height: auto;
    }

    .dokumentinfo .opprettet-dato {
        font-size: 14px;
        color: gray;
        margin-top: 4px;
    }

    /* margin-top her følger IKKE en 1:1 px-til-visuelt-gap-forhold pga.
       clear:both-mekanikken i openhtmltopdf (kalibrert empirisk: 36px ga ~4-5px synlig
       gap, 100px ga ~29px synlig gap). 100px valgt etter visuell verifisering av rendret
       PDF. */
    #header {
        clear: both;
        margin-top: 100px;
    }

    #footer {
        color: gray;
        position: running(footer);
        font-size: 12px;
        margin-top: -25px;
        padding-left: 0.6cm;
    }

    .sidetall {
        float: right;
    }

    #pagenumber:before {
        content: counter(page);
    }

    #pagecount:before {
        content: counter(pages);
    }

    .innholdscontainer {
        margin: 0 0.7cm;
    }

    .person {
        float: left;
    }

    .navn {
        font-weight: bold;
        font-size: 18px;
    }

    .ikke_satt {
        font-style: italic;
    }

    .sporsmalstekst {
        font-weight: bold;
    }

    .fritekst {
        background-color: #EFEFEF;
        margin: 10px 0;
        padding: 10px;
    }
</style>
