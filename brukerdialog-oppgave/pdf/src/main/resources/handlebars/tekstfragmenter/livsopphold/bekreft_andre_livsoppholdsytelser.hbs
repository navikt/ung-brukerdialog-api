        {{~#case "MOTTAR_SVANGERSKAPSPENGER"~}}svangerskapspenger{{~/case~}}
        {{~#case "MOTTAR_UFØRETRYGD"~}}uføretrygd{{~/case~}}
        {{~#case "MOTTAR_INTRODUKSJONSSTØNAD"~}}introduksjonsstønad{{~/case~}}
        {{~#case "MOTTAR_BARNEPENSJON"~}}barnepensjon{{~/case~}}
        {{~#default~}}en annen ytelse til livsopphold{{~/default~}}
    {{~/switch}}. Du kan ikke få aktivitetspenger samtidig som du får {{#switch årsak~}}
        {{~#case "MOTTAR_ARBEIDSAVKLARINGSPENGER"~}}arbeidsavklaringspenger{{~/case~}}
        {{~#case "MOTTAR_TILTAKSPENGER"~}}tiltakspenger{{~/case~}}
