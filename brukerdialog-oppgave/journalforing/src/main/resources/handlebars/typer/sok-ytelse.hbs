<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8"/>
    <title>{{tittel}}</title>
    <meta name="subject" content="{{tittel}}"/>
    <meta name="author" content="nav.no"/>
    {{> style}}
</head>
<body>
{{> partial/header}}

<div class="innholdscontainer">
    <p>{{oppgave.infotekst}}</p>
    <p><strong>Startdato:</strong> {{datoLang oppgave.fomDato}}</p>
    <p>Du finner søknaden på {{> partial/min-side-lenke}}.</p>
    {{#isNotNull oppgave.svarfrist}}
    <div class="frist">
    <p>Fristen for å søke er senest {{datoLang oppgave.svarfrist}}.</p>
    </div>
    {{/isNotNull}}
</div>

{{> partial/footer}}
</body>
</html>
